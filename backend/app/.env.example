# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=groq key here

# Optional: Specify Groq model (defaults to llama-3.1-8b-instant if not set)
# GROQ_MODEL=llama-3.1-8b-instant

# Civic JSON synthesis (second LLM call after retrieval; see CHAT_ARCHITECTURE.md)
# CIVIC_SYNTHESIS_ENABLED=1
# CIVIC_SYNTHESIS_MODEL=llama-3.1-8b-instant

# MongoDB Configuration (for query analytics, caching, and monitoring)
# Replace <password> with your actual MongoDB password, then uncomment to enable
# MONGODB_URI=mongodb+srv://bfi:<password>@cluster0.rstaffu.mongodb.net/?appName=Cluster0
# MONGODB_DB_NAME=saaf_chatbot

# Optional: Agent database path (defaults to :memory: if not set)
# AGENT_DB_PATH=:memory:

# Optional: Enable XLSX agent loading (0 or 1, defaults to 0)
# ENABLE_XLSX_AGENT_LOAD=0

# Optional: Enable verbose agent chat logging (0 or 1, defaults to 0)
# AGENT_CHAT_VERBOSE=0
